# ── LLM endpoint (WAJIB untuk generate cast) ──────────────────
# OpenAI-compatible endpoint. Default: justwoker.icu
LLM_BASE_URL=https://api.justwoker.icu/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-opus-4-8

# ── Neynar (OPSIONAL — hanya kalau mau auto-post ke Farcaster) ──
# Ambil di https://neynar.com (berbayar / ada limit free)
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
